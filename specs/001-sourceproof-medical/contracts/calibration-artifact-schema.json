{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CalibrationArtifact",
  "description": "Versioned bundle required for runtime inference with conformal prediction.",
  "type": "object",
  "required": ["calibration_id", "created_at", "verifier_model", "calibrator_type", "conformal_method", "alpha", "feature_schema_version", "corpus_family", "quantile"],
  "properties": {
    "calibration_id": {
      "type": "string",
      "description": "Unique calibration identifier, e.g., 'uq-cal-2026-08-28'."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of calibration creation."
    },
    "verifier_model": {
      "type": "string",
      "description": "Path or identifier for the trained classifier."
    },
    "calibrator_type": {
      "type": "string",
      "enum": ["temperature", "isotonic", "platt"],
      "description": "Type of probability calibration applied."
    },
    "conformal_method": {
      "type": "string",
      "enum": ["LAC", "APS"],
      "description": "Conformal prediction method used."
    },
    "alpha": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Coverage target complement (e.g., 0.10 for 90% coverage)."
    },
    "feature_schema_version": {
      "type": "string",
      "description": "Version of the evidence feature vector schema."
    },
    "corpus_family": {
      "type": "string",
      "description": "Identifier for the corpus family this calibration applies to."
    },
    "quantile": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "The conformal quantile computed during calibration."
    }
  }
}
