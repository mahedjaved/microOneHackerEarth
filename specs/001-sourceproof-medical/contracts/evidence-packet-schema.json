{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvidencePacket",
  "description": "Versioned collection of retrieved passages with provenance.",
  "type": "object",
  "required": ["packet_id", "corpus_id", "corpus_hash", "retrieval_query", "passages", "retrieval_metadata"],
  "properties": {
    "packet_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this evidence packet."
    },
    "corpus_id": {
      "type": "string",
      "description": "Stable corpus identifier."
    },
    "corpus_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 hash of the corpus files at retrieval time."
    },
    "retrieval_query": {
      "type": "string",
      "description": "The query used for retrieval."
    },
    "passages": {
      "type": "array",
      "items": {"$ref": "#/definitions/Passage"},
      "minItems": 1,
      "description": "Retrieved passages with provenance."
    },
    "retrieval_metadata": {
      "$ref": "#/definitions/RetrievalMetadata",
      "description": "Metadata about the retrieval process."
    }
  },
  "definitions": {
    "Passage": {
      "type": "object",
      "required": ["chunk_id", "document_id", "document_version", "page_location", "text", "provenance_hash"],
      "properties": {
        "chunk_id": {
          "type": "string",
          "description": "Stable chunk identifier within the corpus."
        },
        "document_id": {
          "type": "string",
          "description": "Stable document identifier."
        },
        "document_version": {
          "type": "string",
          "description": "Semantic version of the source document."
        },
        "page_location": {
          "type": "string",
          "description": "Page number, section, or equivalent location."
        },
        "text": {
          "type": "string",
          "description": "The chunk content."
        },
        "provenance_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 of (document_id + document_version + page_location + text)."
        }
      }
    },
    "RetrievalMetadata": {
      "type": "object",
      "required": ["retriever_version", "top_k", "latency_ms"],
      "properties": {
        "retriever_version": {
          "type": "string",
          "description": "Version of the retrieval model."
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of passages retrieved."
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Retrieval latency in milliseconds."
        },
        "top_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Highest similarity score among retrieved passages."
        },
        "score_margin": {
          "type": "number",
          "minimum": 0,
          "description": "Difference between top score and second-highest score."
        },
        "rank_dispersion": {
          "type": "number",
          "minimum": 0,
          "description": "Standard deviation of scores across retrieved passages."
        }
      }
    }
  }
}
